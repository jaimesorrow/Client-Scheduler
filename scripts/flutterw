#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FLUTTER_BIN="$REPO_ROOT/.flutter/flutter/bin/flutter"

if [[ ! -x "$FLUTTER_BIN" ]]; then
  echo "Flutter SDK not found at $FLUTTER_BIN" >&2
  echo "Install Flutter into .flutter/flutter or update scripts/flutterw." >&2
  exit 1
fi

export PATH="$REPO_ROOT/.flutter/flutter/bin:$PATH"
exec "$FLUTTER_BIN" "$@"
